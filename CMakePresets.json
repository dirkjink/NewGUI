{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests",
        "NGUI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (warnings as errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NGUI_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Docs (coverage, test results, API reference)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NGUI_COVERAGE": "ON",
        "NGUI_BUILD_API_DOCS": "ON",
        "NGUI_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzz (libFuzzer, ASan, UBSan; requires CC=clang CXX=clang++)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NGUI_FUZZING": "ON",
        "NGUI_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "skia",
      "displayName": "Skia and SDL3 (vcpkg features skia and sdl3, warnings as errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_MANIFEST_FEATURES": "tests;skia;sdl3",
        "NGUI_WITH_SKIA": "ON",
        "NGUI_WITH_SDL3": "ON",
        "NGUI_BUILD_EXAMPLES": "ON",
        "NGUI_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "docs",
      "configurePreset": "docs"
    },
    {
      "name": "docs-api",
      "configurePreset": "docs",
      "targets": [
        "ngui_api_docs"
      ]
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "skia",
      "configurePreset": "skia"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "inherits": "base",
      "configurePreset": "ci"
    },
    {
      "name": "docs",
      "inherits": "base",
      "configurePreset": "docs",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "test-results.xml"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "configurePreset": "fuzz"
    },
    {
      "name": "skia",
      "inherits": "base",
      "configurePreset": "skia"
    }
  ],
  "workflowPresets": [
    {
      "name": "ci",
      "steps": [
        {
          "type": "configure",
          "name": "ci"
        },
        {
          "type": "build",
          "name": "ci"
        },
        {
          "type": "test",
          "name": "ci"
        }
      ]
    },
    {
      "name": "docs",
      "steps": [
        {
          "type": "configure",
          "name": "docs"
        },
        {
          "type": "build",
          "name": "docs"
        },
        {
          "type": "test",
          "name": "docs"
        },
        {
          "type": "build",
          "name": "docs-api"
        }
      ]
    },
    {
      "name": "fuzz",
      "steps": [
        {
          "type": "configure",
          "name": "fuzz"
        },
        {
          "type": "build",
          "name": "fuzz"
        },
        {
          "type": "test",
          "name": "fuzz"
        }
      ]
    },
    {
      "name": "skia",
      "steps": [
        {
          "type": "configure",
          "name": "skia"
        },
        {
          "type": "build",
          "name": "skia"
        },
        {
          "type": "test",
          "name": "skia"
        }
      ]
    }
  ]
}
